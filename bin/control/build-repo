#!/usr/bin/env bash
# Stages the offline repo in repo-build/stage:
#   repo/packages.txt       what the cluster needs (Slurm, MPI, services)
#   repo/base-packages.txt  everything the template has installed, so the image
#                           can be upgraded to the repo's versions as a matched set
# plus the Slurm RPMs from ~/rpmbuild.
set -euo pipefail

REPO="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$REPO"

RPMS="${RPMS:-$HOME/rpmbuild/RPMS/x86_64}"
OUT="${OUT:-$REPO/repo-build}"
STAGE="$OUT/stage"

rm -rf "$STAGE"
mkdir -p "$STAGE"

createrepo_c -q "$RPMS"
VER="$(rpm -qp --qf '%{VERSION}\n' "$RPMS"/slurm-slurmctld-*.rpm | head -1)"

mapfile -t PKGS < <(cat repo/packages.txt repo/base-packages.txt 2>/dev/null \
  | tr -d '\r' | grep -v -E '^[[:space:]]*(#|$)' | sort -u)
echo "Resolving ${#PKGS[@]} packages with all dependencies (Slurm ${VER})"
dnf download -q --resolve --alldeps --destdir "$STAGE" \
  --repofrompath="slurm-local,file://${RPMS}" \
  --setopt=slurm-local.gpgcheck=0 --setopt=slurm-local.metadata_expire=0 \
  "${PKGS[@]}"
rm -f "$STAGE"/*.i686.rpm

if ls "$STAGE" | grep '^slurm' | grep -v -- "-${VER}-"; then
  echo "The Slurm packages listed above are not ${VER}. Fix the manifest and rerun." >&2
  exit 1
fi

createrepo_c -q "$STAGE"
echo "$(ls "$STAGE"/*.rpm | wc -l) packages, $(du -sh "$STAGE" | cut -f1)"
echo "Repo staged in $STAGE. Next: bin/control/push-kit --repo"

#!/usr/bin/env bash
set -euo pipefail

REPO="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$REPO"
source "$HOME/.tofu-env"

NODE="${NODE:-hpc-pve}"
STORAGE="${STORAGE:-nas-nfs}"
SLOT="${SLOT:-ide2}"   # the head VM's empty CD drive; check with: qm config VMID
AUTH="Authorization: PVEAPIToken=${PROXMOX_VE_API_TOKEN}"
API="${PROXMOX_VE_ENDPOINT}api2/json"

VMID="$(tofu -chdir=tofu/base output -raw head_vm_id)"
NAME="head-kit-$(date -u +%Y%m%dT%H%M%SZ)-$(git rev-parse --short HEAD).iso"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
ISO="${TMP}/${NAME}"

PATHS=()
for p in classes.yml ansible bin/head jobs; do
  if [ -e "$p" ]; then PATHS+=("$p"); fi
done

echo "Building ${NAME}"
xorriso -as mkisofs -quiet -V HEADKIT -J -R -o "$ISO" "${PATHS[@]}"

echo "Uploading to ${STORAGE}"
UPID="$(curl -ks -X POST -H "$AUTH" -F content=iso -F "filename=@${ISO}" \
  "${API}/nodes/${NODE}/storage/${STORAGE}/upload" | jq -r .data)"
while :; do
  STATUS="$(curl -ks -H "$AUTH" "${API}/nodes/${NODE}/tasks/${UPID}/status")"
  if [ "$(echo "$STATUS" | jq -r .data.status)" = "stopped" ]; then break; fi
  sleep 1
done
if [ "$(echo "$STATUS" | jq -r .data.exitstatus)" != "OK" ]; then
  echo "Upload failed: $STATUS" >&2
  exit 1
fi

echo "Attaching to VM ${VMID} (${SLOT})"
curl -ks -X PUT -H "$AUTH" \
  --data-urlencode "${SLOT}=${STORAGE}:iso/${NAME},media=cdrom" \
  "${API}/nodes/${NODE}/qemu/${VMID}/config" | jq -r .data

echo "Done. On the head node run: ~/virtual-cluster/bin/head/pull-kit"

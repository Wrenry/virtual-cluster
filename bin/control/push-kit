#!/usr/bin/env bash
# Builds the HEADKIT ISO (config) and puts it in the head VM's CD drive.
# With --repo it also carries the offline package repo staged by build-repo.
set -euo pipefail

REPO="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$REPO"
source "$HOME/.tofu-env"

WITH_REPO=0
SUFFIX=""
if [ "${1:-}" = "--repo" ]; then WITH_REPO=1; SUFFIX="-repo"; fi

NODE="${NODE:-hpc-pve}"
STORAGE="${STORAGE:-INDEX}"
SLOT="${SLOT:-ide2}"   # the head VM's empty CD drive; check with: qm config VMID
AUTH="Authorization: PVEAPIToken=${PROXMOX_VE_API_TOKEN}"
API="${PROXMOX_VE_ENDPOINT}api2/json"

VMID="$(tofu -chdir=tofu/base output -raw head_vm_id)"
NAME="head-kit-$(date -u +%Y%m%dT%H%M%SZ)-$(git rev-parse --short HEAD)${SUFFIX}.iso"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
ISO="${TMP}/${NAME}"

STAGE="${TMP}/stage"
mkdir -p "$STAGE"
for p in classes.yml ansible bin/head jobs; do
  if [ -e "$p" ]; then cp -a --parents "$p" "$STAGE"/; fi
done

if [ "$WITH_REPO" = 1 ]; then
  REPO_STAGE="$REPO/repo-build/stage"
  if [ ! -d "$REPO_STAGE/repodata" ]; then
    echo "No staged repo. Run bin/control/build-repo first." >&2
    exit 1
  fi
  ln -s "$REPO_STAGE" "$STAGE/hpc-repo"
fi

echo "Building ${NAME}"
xorriso -as mkisofs -quiet -joliet-long -follow-links -V HEADKIT -J -R -o "$ISO" "$STAGE"
echo "ISO size: $(du -h "$ISO" | cut -f1)"

echo "Uploading to ${STORAGE}"
UPID="$(curl -ks -X POST -H "$AUTH" -F content=iso -F "filename=@${ISO}" \
  "${API}/nodes/${NODE}/storage/${STORAGE}/upload" | jq -r .data)"
while :; do
  STATUS="$(curl -ks -H "$AUTH" "${API}/nodes/${NODE}/tasks/${UPID}/status")"
  if [ "$(echo "$STATUS" | jq -r .data.status)" = "stopped" ]; then break; fi
  sleep 1
done
if [ "$(echo "$STATUS" | jq -r .data.exitstatus)" != "OK" ]; then
  echo "Upload failed: $STATUS" >&2
  exit 1
fi

echo "Attaching to VM ${VMID} (${SLOT})"
curl -ks -X PUT -H "$AUTH" \
  --data-urlencode "${SLOT}=${STORAGE}:iso/${NAME},media=cdrom" \
  "${API}/nodes/${NODE}/qemu/${VMID}/config" | jq -r .data

echo "Done. On the head node run: ~/virtual-cluster/bin/head/pull-kit"

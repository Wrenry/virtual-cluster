#!/usr/bin/env bash
set -euo pipefail

DEST="${HOME}/virtual-cluster"
REPO_DEST=/srv/nfs/apps/repo
MNT="$(mktemp -d)"
trap 'sudo umount "$MNT" 2>/dev/null || true; rmdir "$MNT"' EXIT

sudo mount -o ro /dev/disk/by-label/HEADKIT "$MNT"
mkdir -p "$DEST"
rsync -rlt --delete --chmod=u+rwX --exclude=/hpc-repo/ "$MNT"/ "$DEST"/

if [ -d "$MNT/hpc-repo" ]; then
  sudo mkdir -p "$REPO_DEST"
  sudo rsync -rlt --delete --chmod=u+rwX,go+rX "$MNT/hpc-repo"/ "$REPO_DEST"/
  echo "Repo synced: $(ls "$REPO_DEST"/*.rpm | wc -l) packages in $REPO_DEST"
fi

echo "Kit synced to $DEST. Next: ansible-playbook -c local -i localhost, $DEST/ansible/site.yml"

# Managed by Ansible, do not edit by hand
interface={{ vlan_iface }}
bind-interfaces
domain-needed
bogus-priv
no-hosts
no-resolv
domain={{ cluster_domain }}
local=/{{ cluster_domain }}/
expand-hosts
host-record=hpc-head.{{ cluster_domain }},{{ network.head_ip }}

# Dynamic pool for workers; their hostnames (from cloud-init) go into DNS automatically
dhcp-range={{ network.dhcp_start }},{{ network.dhcp_end }},255.255.255.0,12h
dhcp-authoritative
dhcp-hostsdir=/etc/dnsmasq-hosts
# Empty router option = no default gateway on this isolated VLAN
dhcp-option=option:router
dhcp-option=option:dns-server,{{ network.head_ip }}
dhcp-option=option:ntp-server,{{ network.head_ip }}
